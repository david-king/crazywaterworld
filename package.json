{
  "name": "crazywaterworld",
  "version": "1.0.0",
  "description": "微信小游戏《疯狂水世界》协议侧挂机工具：直连游戏网关完成日常/任务/英雄/海面循环，附本地网页控制台",
  "type": "module",
  "main": "src/app.mjs",
  "scripts": {
    "build:ui": "npm run build:server-ui && npm run build:client",
    "bench:console": "node tools/bench-console-load.mjs",
    "start": "node src/app.mjs",
    "test": "npm run check:ui && npm run test:client && npm run typecheck && node tools/run-tests.mjs regression",
    "test:browser": "npm run build:ui && node tools/run-tests.mjs browser",
    "test:world-city": "node tools/run-tests.mjs world-city",
    "test:world-city:browser": "npm run test:browser -- world-city",
    "test:resource-fields": "node tools/run-tests.mjs resource-fields",
    "test:resource-fields:browser": "npm run test:browser -- resource-fields",
    "test:accounts": "node tools/run-tests.mjs accounts",
    "test:shops": "node tools/selftest-shops.mjs && node tools/selftest-shops-http.mjs",
    "test:shops:browser": "npm run test:browser -- shops",
    "test:logs": "node tools/run-tests.mjs logs",
    "test:logs:browser": "npm run test:browser -- logs",
    "test:accounts:browser": "npm run test:browser -- accounts",
    "test:account-controls:browser": "npm run test:browser -- account-controls",
    "test:fleet-speed:browser": "npm run test:browser -- fleet-speed",
    "test:console-version:browser": "npm run test:browser -- console-version",
    "test:silicon-overview": "node tools/run-tests.mjs silicon-overview",
    "test:silicon-overview:browser": "npm run test:browser -- silicon-overview",
    "test:silicon-shortcuts:browser": "npm run test:browser -- silicon-shortcuts",
    "test:unified-config:browser": "npm run test:browser -- unified-config",
    "test:navigation:browser": "npm run test:browser -- navigation",
    "test:dropdowns:browser": "npm run test:browser -- dropdowns",
    "test:player-picker:browser": "npm run test:browser -- player-picker",
    "test:production": "node tools/run-tests.mjs production",
    "test:core-subset": "node tools/run-tests.mjs core-subset",
    "test:capture": "node tools/selftest-raw-capture.mjs && node tools/selftest-douyin-cli.mjs && npm run test:douyin-capture",
    "test:startup": "node tools/selftest-start-console.mjs && node tools/selftest-protocol-dropin.mjs && node tools/selftest-console-address.mjs && node tools/selftest-console-output.mjs",
    "test:macos": "node tools/run-tests.mjs macos",
    "test:config": "node tools/run-tests.mjs config",
    "test:world-boss": "node tools/run-tests.mjs world-boss",
    "test:wxapkg": "node tools/selftest-wxapkg.mjs",
    "test:wechat-native:browser": "npm run test:browser -- wechat-native",
    "test:wechat-native": "node tools/run-tests.mjs wechat-native",
    "test:wechat": "node tools/selftest-wechat-capture.mjs && node tools/selftest-wechat-cli.mjs",
    "capture": "node tools/capture-credentials.mjs",
    "capture:douyin": "node tools/capture-douyin-login.mjs",
    "sync-config": "node tools/sync-config.mjs",
    "sync-resources": "node tools/sync-resources.mjs",
    "sync-art": "node tools/sync-art.mjs",
    "prestart": "npm run build:ui",
    "pretest": "npm run build:ui",
    "test:core": "node tools/run-tests.mjs core",
    "test:progression": "node tools/run-tests.mjs progression",
    "test:gift-library": "node tools/run-tests.mjs gift-library",
    "test:extra": "node tools/run-tests.mjs extra",
    "typecheck": "npm run typecheck:ledger && npm run typecheck:ui",
    "pretest:offline": "npm run build:ui && npm run typecheck",
    "test:offline": "node tools/selftest-offline.mjs",
    "test:alipay": "node tools/run-tests.mjs alipay",
    "test:hero-growth": "node tools/run-tests.mjs hero-growth",
    "test:lineups": "node tools/run-tests.mjs lineups",
    "test:lineups:browser": "npm run test:browser -- lineups",
    "build:server-ui": "esbuild src/ui/console-store.mjs --bundle --platform=browser --format=iife --global-name=CWConsoleState --outfile=src/ui/dist/console-store.js && esbuild src/ui/console.tsx --bundle --platform=node --format=esm --packages=external --outfile=src/ui/dist/console.mjs && tailwindcss -i src/ui/theme.css -o src/ui/dist/theme.css --minify",
    "build:client": "vite build",
    "typecheck:ledger": "tsc -p tsconfig.ledger.json",
    "typecheck:ui": "tsc -p tsconfig.ui.json",
    "check:ui": "biome check .",
    "format:ui": "biome check --write .",
    "test:state": "node tools/selftest-console-state.mjs",
    "test:client": "npm run test:state && node tools/selftest-react-client.mjs && node tools/selftest-chat.mjs && node tools/selftest-items.mjs && node tools/selftest-items-http.mjs && npm run test:shops",
    "test:client:browser": "npm run test:browser -- client",
    "test:weekly-activity": "node tools/run-tests.mjs weekly-activity",
    "test:weekly-activity:browser": "npm run test:browser -- weekly-activity",
    "test:dispatch-order:browser": "npm run test:browser -- dispatch-order",
    "test:douyin-capture": "node tools/douyin-analysis/selfcheck-domain-discovery.mjs && node tools/douyin-analysis/selfcheck-https-observe.mjs && node tools/douyin-analysis/selfcheck-https-observer.mjs"
  },
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "lucide-react": "^1.66.0",
    "playwright-core": "^1.65.1",
    "protobufjs": "^7.6.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
